# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- dependencies ---
/node_modules
/.pnp
.pnp.js

# --- testing ---
/coverage

# --- production ---
# The build is published to gh-pages by `npm run deploy`; it is not versioned on master.
/build

# --- secrets ---
.env
.env.*
*.key
*.pem
service-account*.json
credentials*.json
# Matched by pattern, not by exact name: `serviceAccountKey.json` is camelCase with no hyphen,
# so `service-account*.json` above does not cover it. Verified with `git check-ignore`.
*serviceAccount*.json
*adminsdk*.json
*.p12
*.pfx
# Deliberate negation: a template with no values must ship, or nobody knows which variables
# are required. The `.env.*` rule above would swallow it.
!.env.example

# --- OS and tooling noise ---
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
~$*
__pycache__/
*.py[cod]

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- local working notes and tooling (not published) ---
CLAUDE.md
CONTEXT.md
CHANGELOG.md
*.local.md
.claude/
scripts/
scratch/
tmp/
