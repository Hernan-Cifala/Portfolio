{
  "name": "react-portfolio",
  "version": "1.0.0",
  "homepage": "https://hernan-cifala.github.io/Portfolio",
  "private": true,
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.4.6",
    "react-icons": "^5.3.0",
    "react-slick": "^0.30.2",
    "slick-carousel": "^1.8.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "check-deploy": "node -e \"const git = (c) => require('child_process').execSync('git ' + c).toString().trim(); const branch = git('branch --show-current'); if (branch !== 'master') { console.error('Deploy blocked: on branch ' + branch + ', deploys only go out from master.'); process.exit(1); } if (git('status --porcelain')) { console.error('Deploy blocked: uncommitted changes would be published without being in the repo.'); process.exit(1); }\"",
    "predeploy": "npm run check-deploy && cross-env GENERATE_SOURCEMAP=false npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.2.0",
    "react-scripts": "^5.0.1"
  }
}
